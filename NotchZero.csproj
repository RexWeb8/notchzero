<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NotchZero</AssemblyName>
    <RootNamespace>NotchZero</RootNamespace>
    <StartupObject>NotchZero.Program</StartupObject>
    <ApplicationIcon>NotchZero.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>NotchZero</Product>
    <AssemblyTitle>NotchZero</AssemblyTitle>
    <Company>NotchZero</Company>
    <Description>A Dynamic Island for Windows: music, prayer times, system stats and a little mascot.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416;WFAC010;CS4014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="NotchZero.ico" LogicalName="NotchZero.ico" />
  </ItemGroup>

</Project>
